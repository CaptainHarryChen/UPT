FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];


internalField   uniform (0.05 0 0);


boundaryField
{


    wall
    {
        type noSlip;
    }
    inflow
    {
        type            fixedValue;
        value           $internalField;
    }
    outflow
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (0 0 0);
    }
    sidewalls
    {
        type            noSlip;
    }
    FrontBackPlane
    {
        type            empty;
    }
    defaultFaces
    {
        type            empty;
    }
}


