{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}", // 3 1 16 ${workspaceFolder}/data/transientflow/EmptyCase ~/datasets/transientflow/generated ~/datasets/transientflow/workspace
            "justMyCode": false
        },

        {
            "name": "generateCase.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": ["3", "1", "16", "${workspaceFolder}/data/transientflow/EmptyCase", "~/datasets/transientflow/generated2D", "~/datasets/transientflow/workspace2D"],
            "justMyCode": false
        },

        {
            "name": "generate_city_case.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": ["20", "1000", "32", "${workspaceFolder}/data/transientflow/EmptyCaseCity", "~/datasets/transientflow/generated", "~/datasets/transientflow/workspace"],
            "justMyCode": false
        }
    ]
}
